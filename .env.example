# Supplement an existing .env; do not overwrite existing Cloudflare credentials.
P4FORGE_PUBLIC_URL=https://p4forge.zenogrid.co.kr:8444/
P4FORGE_BOOTSTRAP_ADMIN=law80@zenogrid.co.kr
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ACME_EMAIL=law80@zenogrid.co.kr
CF_ZONE_ID=
CF_API_TOKEN=
# An ACME CNAME delegation can point to a different zone (e.g. ytlaw80.com).
# Loopback for local preview. Set the dedicated server's listening IP for LAN access.
P4FORGE_TLS_BIND=127.0.0.1
# Perforce defaults to loopback. For p4forge.zenogrid.co.kr:1666,
# set P4FORGE_P4_BIND to the host's LAN IP and P4FORGE_P4_PORT to 1666.
P4FORGE_P4_BIND=127.0.0.1
P4FORGE_P4_PORT=16660
# Development defaults. Production: use a random password and matching URL (URL-encode it).
P4FORGE_DB_PASSWORD=p4forge-local-only
P4FORGE_DOCKER_DATABASE_URL=postgres://p4forge:p4forge-local-only@postgres:5432/p4forge
DATABASE_URL=postgres://p4forge:p4forge-local-only@127.0.0.1:15432/p4forge
P4FORGE_P4_TICKETS_FILE=.local/p4tickets

# Direct server execution; Compose uses its dedicated server_artifacts volume.
P4FORGE_ARTIFACT_DIR=.local/artifacts
